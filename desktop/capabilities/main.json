{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "start-page",
  "description": "主窗口的本地启动页（欢迎页、加载中改选、启动失败、图库升级确认、识别结果数据库抢救）只能调用这几条命令；127.0.0.1 上的图库页没有任何权限。",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-welcome-pick",
    "allow-welcome-open",
    "allow-welcome-create",
    "allow-welcome-inspect",
    "allow-welcome-import",
    "allow-welcome-import-status",
    "allow-welcome-import-cancel",
    "allow-startup-choose",
    "allow-startup-retry",
    "allow-startup-upgrade",
    "allow-startup-rescue",
    "allow-startup-diagnostics"
  ]
}
