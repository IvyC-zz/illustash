  "legacy_tables": [
    "CREATE TABLE display_names(\n kind TEXT NOT NULL, key TEXT NOT NULL, lang TEXT NOT NULL, source TEXT NOT NULL, value TEXT NOT NULL,\n PRIMARY KEY(kind,key,lang,source,value))",
    "CREATE TABLE identity_baseline(\n id TEXT PRIMARY KEY,parent_id TEXT,variant TEXT,kind TEXT,merged_into TEXT)",
    "CREATE TABLE links(system TEXT NOT NULL,key TEXT NOT NULL,entity_id TEXT NOT NULL REFERENCES entities(id),\n current INTEGER NOT NULL DEFAULT 1,source TEXT NOT NULL,added_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,PRIMARY KEY(system,key))",
    "CREATE TABLE name_aliases(kind TEXT NOT NULL,key TEXT NOT NULL,value TEXT NOT NULL,position INTEGER NOT NULL,PRIMARY KEY(kind,key,value))",
    "CREATE TABLE names(entity_id TEXT NOT NULL REFERENCES entities(id),lang TEXT NOT NULL DEFAULT '' CHECK(lang IN ('','zh','ja','en')),\n value TEXT NOT NULL,source TEXT NOT NULL,role TEXT NOT NULL CHECK(role IN ('display','alias')),preferred INTEGER NOT NULL DEFAULT 0,\n position INTEGER NOT NULL DEFAULT 0,PRIMARY KEY(entity_id,role,lang,source,value))",
    "CREATE TABLE work_review(entity_id TEXT PRIMARY KEY REFERENCES entities(id),\n        status TEXT NOT NULL DEFAULT 'pending',note TEXT NOT NULL DEFAULT '',parent_locked INTEGER NOT NULL DEFAULT 0)",
    "CREATE INDEX links_entity ON links(entity_id,system)",
    "CREATE INDEX names_value ON names(value COLLATE NOCASE)"
  ],
